OPENAI_API_KEY=sk-your-key-here

# CORS: comma-separated list of allowed origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Model to use for analysis (gpt-4o-mini is fast + cheap; gpt-4o for higher accuracy)
OPENAI_MODEL=gpt-4o-mini

# Analysis config
MAX_RESUME_CHARS=15000        # Truncate resume text if longer
MAX_JD_CHARS=8000             # Truncate JD text if longer
EVALUATION_VERSION=1.0
